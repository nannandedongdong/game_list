{
  "server": {
    "host": "127.0.0.1",
    "port": 4173
  },
  "repository": {
    "remote": "origin",
    "branch": "main",
    "contentRoot": "public",
    "githubUrl": "https://github.com/nannandedongdong/game_list"
  },
  "publicBaseUrl": "https://raw.githubusercontent.com/nannandedongdong/game_list/main/public",
  "fallbackPublicBaseUrl": "https://cdn.jsdelivr.net/gh/nannandedongdong/game_list@main/public",
  "limits": {
    "romBytes": 10485760,
    "coverBytes": 2097152,
    "zipMaxEntries": 2048,
    "zipMaxUncompressedBytes": 134217728
  },
  "gameTypes": {
    "GBA": {
      "catalog": "gba.json",
      "extensions": [".gba", ".zip"]
    },
    "MD": {
      "catalog": "md.json",
      "extensions": [".md", ".gen", ".smd", ".bin", ".zip"]
    },
    "CPS1": {
      "catalog": "cps1.json",
      "extensions": [".zip"],
      "uploadEnabled": false
    },
    "FC": {
      "catalog": "fc.json",
      "extensions": [".nes", ".fds", ".unf", ".zip"]
    }
  }
}
