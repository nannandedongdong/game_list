{
  "server": {
    "host": "127.0.0.1",
    "port": 4173
  },
  "repository": {
    "remote": "origin",
    "branch": "main",
    "contentRoot": "public",
    "githubUrl": "https://github.com/nannandedongdong/game_list"
  },
